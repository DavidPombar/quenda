{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DavidPombar/quenda/blob/main/docs/architecture/export-format.schema.json",
  "title": "Quenda municipality export v2",
  "type": "object",
  "required": [
    "format",
    "version",
    "exportedAt",
    "municipality",
    "facilities",
    "users",
    "bookings",
    "notifications",
    "auditEvents",
    "consents",
    "legalTexts",
    "logos",
    "bookingBlocks",
    "notificationPreferences",
    "messages"
  ],
  "properties": {
    "format": {
      "const": "quenda-municipality-export"
    },
    "version": {
      "const": 2
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "municipality": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "name",
        "timezone",
        "locale",
        "advanceDays",
        "cancellationHours",
        "maxActiveBookings",
        "contact",
        "legalText",
        "legalVersion",
        "retentionMonths",
        "primaryColor",
        "holidaysCalendar",
        "noShowLimit",
        "noShowWindowDays",
        "noShowBlockDays",
        "reminderHours",
        "mailSenderName",
        "mailReplyTo"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "timezone": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "advanceDays": {
          "type": "integer"
        },
        "cancellationHours": {
          "type": "integer"
        },
        "maxActiveBookings": {
          "type": "integer"
        },
        "contact": {
          "type": "string"
        },
        "legalText": {
          "type": "string"
        },
        "legalVersion": {
          "type": "string"
        },
        "retentionMonths": {
          "type": "integer"
        },
        "primaryColor": {
          "type": "string"
        },
        "holidaysCalendar": {
          "type": "string"
        },
        "noShowLimit": {
          "type": "integer"
        },
        "noShowWindowDays": {
          "type": "integer"
        },
        "noShowBlockDays": {
          "type": "integer"
        },
        "waitlistMaxEntries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Open waiting-list entries per person (#96); 0 switches it off. Optional in older packages"
        },
        "waitlistOfferMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 240,
          "description": "Minutes a freed place is held for the person offered it (#96). Optional in older packages"
        },
        "reminderHours": {
          "type": "integer"
        },
        "mailSenderName": {
          "type": "string"
        },
        "mailReplyTo": {
          "type": "string"
        },
        "storeNif": {
          "type": "boolean",
          "description": "Residency verification keeps the NIF. Optional: defaults to false."
        },
        "dataLicense": {
          "type": "string",
          "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC0-1.0", "ODbL-1.0"],
          "description": "Licence of the open data. Optional: defaults to CC-BY-4.0."
        },
        "dir3Code": {
          "type": ["string", "null"],
          "description": "DIR3 code of the council, the open data publisher. Optional."
        },
        "analyticsEnabled": {
          "type": "boolean",
          "description": "Whether the citizen app counts page views in the deployment's Umami. Optional: defaults to false."
        },
        "analyticsUrl": {
          "type": "string",
          "description": "Exports from before #57 only: the council's own Umami. On import, a non-empty value switches analytics on."
        },
        "analyticsWebsiteId": {
          "type": ["string", "null"],
          "description": "Exports from before #57 only. Ignored on import."
        },
        "accessibilityUnit": {
          "type": "string"
        },
        "accessibilityEmail": {
          "type": "string"
        },
        "accessibilityPhone": {
          "type": "string"
        },
        "accessibilityReviewedOn": {
          "type": "string",
          "format": "date"
        },
        "accessibilityMethod": {
          "type": "string",
          "enum": ["self", "external"]
        },
        "accessibilityExceptionsGl": {
          "type": "string"
        },
        "accessibilityExceptionsEs": {
          "type": "string"
        },
        "enabledCategories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessWebhookUrl": {
          "type": "string"
        },
        "accessWebhookSecretSealed": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "facilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "sport",
          "address",
          "description",
          "accessible",
          "status",
          "slotMinutes",
          "priceCents",
          "openingCalendar",
          "rules",
          "followsMunicipalHolidays"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sport": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "accessible": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "slotMinutes": {
            "type": "integer"
          },
          "priceCents": {
            "type": "integer"
          },
          "openingCalendar": {
            "type": "string"
          },
          "rules": {
            "type": "string"
          },
          "followsMunicipalHolidays": {
            "type": "boolean"
          },
          "latitude": {
            "type": ["number", "null"],
            "minimum": -90,
            "maximum": 90,
            "description": "WGS 84. Optional; set together with longitude."
          },
          "longitude": {
            "type": ["number", "null"],
            "minimum": -180,
            "maximum": 180,
            "description": "WGS 84. Optional; set together with latitude."
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "description": "Courts and spaces, parents before their parts. Optional: packages without it get one resource per facility, with the facility's id.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "facilityId",
          "name",
          "position",
          "parentId",
          "active",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "facilityId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "parentId": {
            "type": ["string", "null"]
          },
          "active": {
            "type": "boolean"
          },
          "capacity": {
            "description": "Places of a shared court (#95). Optional; null or absent keeps it exclusive.",
            "type": ["integer", "null"],
            "minimum": 2,
            "maximum": 200
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "role",
          "deletedAt",
          "email",
          "locale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "deletedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "email": {
            "type": ["string", "null"]
          },
          "locale": {
            "type": ["string", "null"]
          },
          "assurance": {
            "enum": ["demo", "email", "eid", "local"],
            "description": "How the identity was proven. Optional: defaults to demo."
          },
          "nifCiphertext": {
            "type": ["string", "null"],
            "description": "Encrypted NIF; readable only with the same QUENDA_DATA_KEY. Optional."
          },
          "nifDigest": {
            "type": ["string", "null"],
            "description": "HMAC digest of the NIF for lookups. Optional."
          },
          "prefersFamilyTariff": {
            "type": "boolean"
          },
          "organizationId": {
            "type": ["string", "null"],
            "description": "Club the person represents (#17)"
          }
        },
        "additionalProperties": false
      }
    },
    "identities": {
      "description": "Identity provider links, so people keep their account. Optional.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "userId", "issuer", "subject", "createdAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "bookings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "facilityId",
          "start",
          "end",
          "status",
          "createdAt",
          "cancelledAt",
          "cancellationHours",
          "cancelledBy",
          "cancellationReason",
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": ["string", "null"]
          },
          "facilityId": {
            "type": "string"
          },
          "resourceId": {
            "type": "string",
            "description": "Booked court or space. Optional: defaults to the facility's default resource."
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "cancellationHours": {
            "type": ["integer", "null"]
          },
          "cancelledBy": {
            "type": ["string", "null"]
          },
          "cancellationReason": {
            "type": ["string", "null"]
          },
          "sequence": {
            "type": "integer"
          },
          "tariffCategory": {
            "type": ["string", "null"]
          },
          "priceCents": {
            "type": ["integer", "null"],
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "bookingId",
          "kind",
          "createdAt",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "bookingId": {
            "type": ["string", "null"],
            "description": "Null for a waiting-list offer, which belongs to its entry (#96)"
          },
          "waitlistEntryId": {
            "type": ["string", "null"],
            "description": "Waiting-list entry of an offer (#96); optional in older packages"
          },
          "enrolmentId": {
            "type": ["string", "null"],
            "description": "Enrolment the notice belongs to (#97)"
          },
          "activitySessionId": {
            "type": ["string", "null"],
            "description": "Cancelled activity date the notice is about (#97)"
          },
          "kind": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": ["object", "null"]
          },
          "dedupeKey": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "auditEvents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "actorId",
          "action",
          "resourceId",
          "occurredAt",
          "actorRole",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actorId": {
            "type": ["string", "null"]
          },
          "action": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actorRole": {
            "type": ["string", "null"]
          },
          "details": {
            "type": ["object", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "consents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "userId", "legalVersion", "acceptedAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "legalVersion": {
            "type": "string"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "legalTexts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "textGl", "textEs", "publishedAt"],
        "properties": {
          "version": {
            "type": "string"
          },
          "textGl": {
            "type": "string"
          },
          "textEs": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "logos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contentType", "data", "sha256", "updatedAt"],
        "properties": {
          "contentType": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "contentEncoding": "base64"
          },
          "sha256": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "icon": {
            "type": ["string", "null"],
            "contentEncoding": "base64",
            "description": "Square 512 px PNG icon of the installed app, drawn from the logo (#24). Absent in older exports."
          },
          "iconSha256": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "bookingBlocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "userId", "bookingId", "start", "end", "liftedAt"],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "bookingId": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "liftedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "notificationPreferences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["userId", "kind", "channel", "enabled", "updatedAt"],
        "properties": {
          "userId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "channel": {
            "type": "string",
            "enum": ["email", "push"]
          },
          "enabled": {
            "type": "boolean"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "bookingId",
          "kind",
          "channel",
          "dedupeKey",
          "createdAt",
          "availableAt",
          "attempts",
          "lockedUntil",
          "sentAt",
          "lastError"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "bookingId": {
            "type": ["string", "null"],
            "description": "Null for a waiting-list offer, which belongs to its entry (#96)"
          },
          "waitlistEntryId": {
            "type": ["string", "null"],
            "description": "Waiting-list entry of an offer (#96); optional in older packages"
          },
          "enrolmentId": {
            "type": ["string", "null"],
            "description": "Enrolment the notice belongs to (#97)"
          },
          "activitySessionId": {
            "type": ["string", "null"],
            "description": "Cancelled activity date the notice is about (#97)"
          },
          "kind": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "dedupeKey": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "availableAt": {
            "type": "string",
            "format": "date-time"
          },
          "attempts": {
            "type": "integer"
          },
          "lockedUntil": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "sentAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "lastError": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "facilityPrices": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string"
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["facilityId", "category", "priceCents"],
        "additionalProperties": false
      }
    },
    "userCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string"
          },
          "status": {
            "enum": ["requested", "verified", "rejected"]
          },
          "requestedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "decidedAt": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": [
          "userId",
          "category",
          "status",
          "requestedAt",
          "decidedAt"
        ],
        "additionalProperties": false
      }
    },
    "facilityStatusPeriods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": ["active", "maintenance", "closed"]
          },
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["facilityId", "status", "start", "end"],
        "additionalProperties": false
      }
    },
    "accessKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kid": {
            "type": "string"
          },
          "publicJwk": {
            "type": "object"
          },
          "privateKeySealed": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "retiredAt": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "kid",
          "publicJwk",
          "privateKeySealed",
          "createdAt",
          "retiredAt"
        ]
      }
    },
    "checkIns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "bookingId": {
            "type": "string"
          },
          "sequence": {
            "type": "integer"
          },
          "actorId": {
            "type": ["string", "null"]
          },
          "method": {
            "type": "string"
          },
          "checkedInAt": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "bookingId",
          "sequence",
          "actorId",
          "method",
          "checkedInAt",
          "recordedAt"
        ]
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "taxId": {
            "type": ["string", "null"]
          },
          "sport": {
            "type": ["string", "null"]
          },
          "contactEmail": {
            "type": ["string", "null"]
          },
          "createdAt": {
            "type": "string"
          },
          "archivedAt": {
            "type": ["string", "null"]
          }
        },
        "required": [
          "id",
          "name",
          "taxId",
          "sport",
          "contactEmail",
          "createdAt",
          "archivedAt"
        ]
      }
    },
    "seasonCampaigns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startsOn": {
            "type": "string",
            "format": "date"
          },
          "endsOn": {
            "type": "string",
            "format": "date"
          },
          "criteriaGl": {
            "type": "string"
          },
          "criteriaEs": {
            "type": "string"
          },
          "facilityIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "startsOn",
          "endsOn",
          "criteriaGl",
          "criteriaEs",
          "facilityIds",
          "createdAt"
        ]
      }
    },
    "seasonAllocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "campaignId": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "facilityId": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          },
          "weekdays": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
