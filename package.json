{
  "name": "quenda",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "backend",
    "frontend/app",
    "frontend/admin",
    "frontend/web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,app,admin,web 'npm run dev -w backend' 'npm run dev -w frontend/app' 'npm run dev -w frontend/admin' 'npm run dev -w frontend/web'",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "node scripts/check-architecture.mjs && eslint .",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e -w backend",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:e2e && npm run build",
    "format": "prettier --write backend/src backend/test frontend/app/src frontend/admin/src frontend/web/src scripts *.json *.yml",
    "licenses": "node scripts/check-licenses.mjs",
    "illustrations": "node scripts/build-illustrations.mjs",
    "test:smoke": "node scripts/smoke-browser.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "prettier": "^3.6.2",
    "@types/node": "^24.0.0"
  },
  "msw": {
    "workerDirectory": [
      "frontend/app/public",
      "frontend/admin/public"
    ]
  }
}
