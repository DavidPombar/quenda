# Local demonstration values only. Export variables before starting the API.
DATABASE_URL=postgres://quenda:quenda_local@127.0.0.1:55432/quenda
DEMO_MODE=true
HOST=127.0.0.1
PORT=3001
# Email notices: one SMTP server per deployment (Mailpit in development).
SMTP_URL=smtp://127.0.0.1:1025
# Citizens can sign in with a one-time code by email when a mail server is configured (#8).
# EMAIL_LOGIN=false turns it off.
# EMAIL_LOGIN=true
MAIL_FROM=quenda@localhost
# Base URL used in links inside email.
APP_BASE_URL=http://127.0.0.1:5173
# Signs the unsubscribe links; set a long random value outside the demo.
UNSUBSCRIBE_SECRET=
WORKER_INTERVAL_MS=15000
# Web Push (VAPID). The API and the worker need the same pair: `npx web-push generate-vapid-keys`.
# Without them push notices are unavailable, except in the demo, which uses a public pair.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:deportes@concello.example
# Seals the per-municipality QR signing keys and webhook secrets; required outside the demo.
ACCESS_KEY_SECRET=
# Production hardening (defaults shown). The container image sets NODE_ENV=production.
# NODE_ENV=production
# COOKIE_SECURE=true            # defaults to true when NODE_ENV=production
# TRUST_PROXY=loopback, uniquelocal
# RATE_LIMIT_PER_MINUTE=600
# SESSION_RATE_LIMIT_PER_MINUTE=30
# SESSION_PURGE_MINUTES=60

# Electronic identification (OIDC). Enabled only when OIDC_ISSUER, OIDC_CLIENT_ID and PUBLIC_URL
# are set. Values below match the local Keycloak reference realm (`npm run identity:up`); the
# secret is for local development only, never production.
# PUBLIC_URL=http://127.0.0.1:5173
# OIDC_ISSUER=http://127.0.0.1:8081/realms/quenda
# Optional: where the API fetches discovery when it cannot reach the issuer itself (Compose).
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/quenda
# OIDC_CLIENT_ID=quenda
# OIDC_CLIENT_SECRET=quenda-local-dev-secret-NO-PRODUCCION
# OIDC_LABEL=Cl@ve
# OIDC_IDP_HINT=clave

# Field encryption key for the NIF (base64 of 32 random bytes): `openssl rand -base64 32`.
# Without it the NIF is never stored, even where the municipality enables residency checks.
# QUENDA_DATA_KEY=
# Public origin used in absolute open data URLs (DCAT, facility links). Required in production.
# PUBLIC_URL=https://reservas.example.gal
# Map tiles for the facility page (#26). The tile server receives each visitor's IP address, so a
# deployment can use its own or the provincial council's server instead of OpenStreetMap.
# MAP_TILE_URL is read by the API; MAP_TILE_ORIGIN (the same server's origin) by the web image's CSP.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors
# MAP_TILE_ORIGIN=https://tile.openstreetmap.org

# Web analytics in the deployment's own Umami (#57). Optional: without UMAMI_URL nothing is sent.
# `npm run analytics:up` and `npm run analytics:setup` print these values for a local Umami.
# UMAMI_URL=http://127.0.0.1:8095
# UMAMI_APP_WEBSITE_ID=
# UMAMI_WEB_WEBSITE_ID=
# Read-only Umami user for the operator and manager dashboards.
# UMAMI_USERNAME=quenda-lector
# UMAMI_PASSWORD=
# DEPLOYMENT_TIMEZONE=Europe/Madrid
