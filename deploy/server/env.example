# Values for deploy/server/compose.yml. install.sh writes .env with fresh secrets; never commit it.
# Public name of the instance. Without a domain of your own, <ip-with-dashes>.sslip.io works.
QUENDA_DOMAIN=reservas.example.gal
# true only for a public demonstration with synthetic municipalities and accounts.
DEMO_MODE=false
# Secrets: `openssl rand -base64 32` for the data key, `openssl rand -hex 32` for the others.
POSTGRES_PASSWORD=
QUENDA_DATA_KEY=
ACCESS_KEY_SECRET=
UNSUBSCRIBE_SECRET=
# Outgoing mail (notices and sign-in codes). Hetzner blocks ports 25 and 465 on new servers; use a
# provider on port 587. Without SMTP_URL no mail is sent.
SMTP_URL=
MAIL_FROM=
# A public demo has no mailbox anyone could read, so it turns sign-in by email off.
EMAIL_LOGIN=
# Web Push: `npx web-push generate-vapid-keys`. The demo uses a public pair when empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
