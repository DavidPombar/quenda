# TLS front proxy for deploy/server/compose.yml (Caddy, Apache-2.0). Caddy obtains and renews the
# certificate for QUENDA_DOMAIN automatically; ports 80 and 443 must reach the server.
{$QUENDA_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy web:80
}
