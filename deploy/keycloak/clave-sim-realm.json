{
  "realm": "clave-sim",
  "displayName": "Cl@ve SIMULADO (entorno local de pruebas, no es Cl@ve)",
  "displayNameHtml": "<strong>Cl@ve SIMULADO</strong> &middot; entorno local de pruebas, no es Cl@ve",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["es", "gl", "en"],
  "defaultLocale": "es",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"multivalued\": false, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}}, {\"name\": \"email\", \"displayName\": \"${email}\", \"multivalued\": false, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"multivalued\": false, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"multivalued\": false, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}}, {\"name\": \"nif\", \"displayName\": \"NIF\", \"multivalued\": false, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\"]}, \"validations\": {\"length\": {\"max\": 16}}}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ],
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "clave-sim-local-signing-NOT-SECRET",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "algorithm": ["RS256"],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ]
        }
      },
      {
        "name": "hmac-generated",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"],
          "algorithm": ["HS512"]
        }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "priority": ["100"]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "http://127.0.0.1:8081/realms/quenda",
      "name": "Quenda (broker Keycloak) — SP de la SIMULACIÓN de Cl@ve",
      "description": "SIMULACIÓN de Cl@ve para pruebas locales. Personas, NIF y claves ficticios.",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://127.0.0.1:8081/realms/quenda/broker/clave/endpoint"
      ],
      "attributes": {
        "saml.server.signature": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml.server.signature.keyinfo.ext": "false",
        "saml.server.signature.keyinfo.xmlSigKeyInfoKeyNameTransformer": "KEY_ID",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml.assertion.signature": "false",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.force.post.binding": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username",
        "saml_assertion_consumer_url_post": "http://127.0.0.1:8081/realms/quenda/broker/clave/endpoint",
        "saml_single_logout_service_url_post": "http://127.0.0.1:8081/realms/quenda/broker/clave/endpoint"
      },
      "protocolMappers": [
        {
          "name": "nombre",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "nombre",
            "attribute.nameformat": "Basic",
            "friendly.name": "Nombre",
            "user.attribute": "firstName"
          }
        },
        {
          "name": "apellidos",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "apellidos",
            "attribute.nameformat": "Basic",
            "friendly.name": "Apellidos",
            "user.attribute": "lastName"
          }
        },
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "Correo",
            "user.attribute": "email"
          }
        },
        {
          "name": "nif",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "consentRequired": false,
          "config": {
            "attribute.name": "nif",
            "attribute.nameformat": "Basic",
            "friendly.name": "NIF",
            "user.attribute": "nif"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "99999999r",
      "enabled": true,
