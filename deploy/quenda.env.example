# Application settings for the api and worker containers (#27). Copy to deploy/quenda.env,
# fill in every REQUIRED value and `chmod 600` it. Never commit it. Leave settings you do not
# use commented out: an empty value is not the same as an unset one.
# Generate secrets with: openssl rand -base64 32
# The domain, database and demo switch come from deploy/.env and compose.prod.yml.

# Seals each council's QR signing keys and webhook secrets. REQUIRED: the API does not start
# without it. Keep a copy with the backup password; if it is lost, every manager must rotate
# the access key and the webhook secret in the backoffice.
ACCESS_KEY_SECRET=
# Signs unsubscribe links in email. REQUIRED (otherwise links break on every restart).
UNSUBSCRIBE_SECRET=
# Encrypts the NIF where a council checks residency (base64 of 32 bytes). Without it the NIF
# is never stored. If it is lost, stored NIFs cannot be read: keep a copy.
# QUENDA_DATA_KEY=

# Email: notices, reminders and sign-in codes, through the council's or deputación's relay.
# REQUIRED in practice: without it no email leaves and email sign-in is not offered.
SMTP_URL=smtp://usuario:contrasinal@smtp.concello.example:587
MAIL_FROM=Reservas deportivas <reservas@concello.example>
# Citizens and staff sign in with a one-time code by email. EMAIL_LOGIN=false turns it off.
# EMAIL_LOGIN=true

# Web Push. Generate once with `npx web-push generate-vapid-keys` and never change them:
# changing them drops every device subscription. Without them there are no push notices.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:deportes@concello.example

# Electronic identification (Cl@ve through the deputación's OIDC broker). Optional; see
# docs/architecture/identity.md.
# OIDC_ISSUER=https://identidade.deputacion.example/realms/quenda
# OIDC_CLIENT_ID=quenda
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Cl@ve
# OIDC_IDP_HINT=clave

# Map tiles. The tile server receives each visitor's IP: prefer the deputación's own server.
# Set MAP_TILE_ORIGIN in deploy/.env to the same server.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# Web analytics in the deployment's own Umami. Optional (docs/architecture/analytics.md).
# UMAMI_URL=
# UMAMI_APP_WEBSITE_ID=
# UMAMI_WEB_WEBSITE_ID=
# UMAMI_USERNAME=
# UMAMI_PASSWORD=

# DEPLOYMENT_TIMEZONE=Europe/Madrid
