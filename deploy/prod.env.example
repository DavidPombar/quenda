# Compose settings for deploy/compose.prod.yml (#27): domain, database and backups.
# Copy to deploy/.env, fill in every REQUIRED value and `chmod 600` it. Never commit it.
# Generate secrets with: openssl rand -base64 32

# Public domain; its DNS A/AAAA record must point to this server. REQUIRED
QUENDA_DOMAIN=reservas.concello.example
# Starts Caddy for TLS on ports 80 and 443. Remove the line behind Coolify or another TLS proxy.
COMPOSE_PROFILES=caddy
# Time zone of scheduled backups and of the deployment's operator figures.
DEPLOYMENT_TIMEZONE=Europe/Madrid

# PostgreSQL password, used only inside the Compose network. REQUIRED
POSTGRES_PASSWORD=

# Encrypts the restic backup repository. REQUIRED. Without it no backup can be read:
# keep a copy outside this server (docs/operacion/copias-de-seguridad.md).
RESTIC_PASSWORD=
# Where backups go. Default: BACKUP_DIR on this host, which should be another disk.
# Off-site, e.g. the deputación's MinIO or any S3 service, or SFTP:
# RESTIC_REPOSITORY=s3:https://s3.deputacion.example/quenda-concello
# RESTIC_REPOSITORY=sftp:copias@copias.deputacion.example:/quenda
# BACKUP_DIR=/srv/quenda-copias
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Cron schedule (in DEPLOYMENT_TIMEZONE) and how many snapshots to keep.
# BACKUP_SCHEDULE=30 3 * * *
# BACKUP_KEEP=--keep-daily 7 --keep-weekly 5 --keep-monthly 12

# Origin of the map tile server, for the web container's CSP; must match MAP_TILE_URL in quenda.env.
# MAP_TILE_ORIGIN=https://tile.openstreetmap.org
